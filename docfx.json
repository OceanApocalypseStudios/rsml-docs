{
	"$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
	"metadata": [
		{
			"src": [
				{
					"src": "rsml/src/",
					"files": [
						"**/*.csproj"
					]
				}
			],
			"properties": {
				"TargetFramework": "net10.0"
			},
			"output": "docs/api/net10.0",
			"useClrTypeNames": true,
			"outputFormat": "markdown",
			"memberLayout": "samePage",
			"namespaceLayout": "nested",
			"enumSortOrder": "declaringOrder",
			"globalNamespaceId": "OceanApocalypse.RSML",
			"includeExplicitInterfaceImplementations": true
		},
		{
			"src": [
				{
					"src": "rsml/src/",
					"files": [
						"RSML/*.csproj",
						"RSML.Language.*/*.csproj",
						"RSML.Toolchain.*/*.csproj"
					]
				}
			],
			"properties": {
				"TargetFramework": "net8.0"
			},
			"output": "docs/api/net8.0",
			"useClrTypeNames": true,
			"outputFormat": "markdown",
			"memberLayout": "samePage",
			"namespaceLayout": "nested",
			"enumSortOrder": "declaringOrder",
			"globalNamespaceId": "OceanApocalypse.RSML",
			"includeExplicitInterfaceImplementations": true
		}
	],
	"rules": {
		"InvalidHref": "error"
	},
	"build": {
		"content": [
			{
				"files": [
					"**/*.{md,yml}"
				],
				"exclude": [
					"__site/**"
				]
			}
		],
		"resource": [
			{
				"files": [
					"images/**",
					"articles/images/**"
				]
			}
		],
		"output": "__site",
		"template": [
			"default",
			"modern",
			"templates/override"
		],
		"globalMetadata": {
			"_appName": "Red Sea Modern Language",
			"_appTitle": "Red Sea Modern Language",
			"_appFaviconPath": "images/favicon.ico",
			"_appLogoPath": "images/xsmall.png",
			"_enableSearch": true,
			"pdf": true,
			"_enableNewTab": true,
			"_appFooter": "See on <a href=\"https://github.com/OceanApocalypse/RedSeaModernLanguage/\">GitHub</a>.<br/>Docs made with <a href=\"https://dotnet.github.io/docfx/\">DocFX</a> and <a href=\"https://ovasquez.github.io/docfx-material/\">Material</a>.",
			"_copyrightFooter": "OceanApocalypse. Documentation licensed under CC0 1.0."
		},
		"markdownEngineProperties": {
			"markdigExtensions": [
				"SmartyPants",
				"ListExtras",
				"Footnotes",
				"Footers",
				"Figures",
				"DefinitionLists"
			]
		},
		"postProcessors": [
			"ExtractSearchIndex"
		]
	}
}